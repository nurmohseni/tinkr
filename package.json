{
  "name": "tinkr",
  "private": true,
  "scripts": {
    "bootstrap": "yarn",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "yarn workspace tinkr-main rebuild",
    "start:main": "yarn workspace tinkr-main start",
    "start:renderer": "yarn workspace tinkr-renderer start",
    "start": "run-p start:main start:renderer",
    "build": "yarn workspaces run build",
    "prepackage": "run-s build",
    "package": "node ./scripts/package.js",
    "prerelease": "run-s package",
    "release": "node ./scripts/release.js",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint"
  },
  "devDependencies": {
    "@octokit/rest": "^18.12.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "electron-builder-squirrel-windows": "^26.15.3",
    "fast-glob": "^3.3.3",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2"
  },
  "version": "0.1.0-beta.1",
  "workspaces": [
    "packages/*"
  ]
}
