{
  "name": "tinkr",
  "private": true,
  "scripts": {
    "bootstrap": "yarn",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "yarn workspace tinkr-main rebuild",
    "start:main": "yarn workspace tinkr-main start",
    "start:renderer": "yarn workspace tinkr-renderer start",
    "fonts": "node scripts/fetch-fonts.js",
    "start": "node scripts/fetch-fonts.js && run-p start:main start:renderer",
    "mcp": "node packages/tinkr-mcp/src/cli.js",
    "build": "node scripts/fetch-fonts.js && yarn workspace tinkr-main build && yarn workspace tinkr-renderer build",
    "prepackage": "run-s build",
    "package": "node ./scripts/package.js",
    "prerelease": "run-s package",
    "release": "node ./scripts/release.js",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report e2e/report"
  },
  "devDependencies": {
    "@octokit/rest": "^18.12.0",
    "@playwright/test": "^1.64.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "electron-builder-squirrel-windows": "^26.15.3",
    "fast-glob": "^3.3.3",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2"
  },
  "version": "0.4.1",
  "workspaces": [
    "packages/*"
  ]
}
