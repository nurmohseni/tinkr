/** Laravel's database manager, which is what `app('db')` is. */
class TinkrFixtureDbManager
{
    public function connection($name = null)
    {
        return TinkrFixture::connection($name);
    }

    public function table($name)
    {
        return $this->connection();
    }
}

/** The container the app's `app()` helper answers from. */
class TinkrFixture
{
    private static $connection;
    private static $events;

    public static function connection($name = null)
    {
        if (!self::$connection) {
            self::$connection = new TinkrFixtureConnection($name ?: 'fixture');
        }

        return self::$connection;
    }

    public static function events()
    {
        if (!self::$events) {
            self::$events = new TinkrFixtureEvents();
        }

        return self::$events;
    }

    public static function bound($key)
    {
        return in_array($key, ['db', 'events'], true);
    }

    public static function make($key)
    {
        if ($key === 'db') {
            return new TinkrFixtureDbManager();
        }

        return self::events();
    }
}

function app($key = null)
{
    if ($key === null) {
        return new class {
            public function bound($key)
            {
                return TinkrFixture::bound($key);
            }
        };
    }

    return TinkrFixture::make($key);
}

/** psysh's dump, near enough: print and keep the value. */
function dump(...$values)
{
    foreach ($values as $value) {
        echo var_export($value, true), PHP_EOL;
    }

    return count($values) === 1 ? $values[0] : $values;
}

function dd(...$values)
{
    dump(...$values);
    exit(1);
}

/**
 * `collect()` as the fixture spells it: the values it was given, with the one
 * method a snippet here asks of them. Laravel's collection is a large dependency
 * to install for a suite whose subject is the app, and `sum()` is what a
 * snippet in it computes.
 */
class TinkrFixtureCollection
{
    private $items;

    public function __construct($items = [])
    {
        $this->items = $items;
    }

    public function sum()
    {
        return array_sum($this->items);
    }
}

function collect($items = [])
{
    return new TinkrFixtureCollection($items);
}

// psysh never lets a line the code prints reach php's own writer: it buffers the
// output, a chunk at a time, and writes it to its output stream itself (see
// psysh's ExecutionCleanupState). That is not a detail here. The app starts the
// session with `-d cli.pager=cat` (see Session's withoutPager), and with the
// readline extension loaded php's writer copies everything it is handed into
// that pager as well as onto the terminal — so a plain `echo` arrives twice, the
// second copy a 4 KB stdio buffer behind, spliced into whatever comes next. The
// fixture writes the way psysh does, so it answers the way psysh does.
ob_start(function ($out) {
    fwrite(STDOUT, $out);

    return '';
}, 1);

// `tinker --execute=<code>` is how a Laravel Cloud run reaches a project: one
// command, one eval, and the process ends. The code is evaluated here, at the
// top level, which is the scope the interactive loop's own eval runs in — so the
// wrapper's variables, `DB` and the query event behave exactly as they do in a
// session, and the caller reads the same envelope out of stdout.
$execute = null;

foreach (array_slice($argv, 1) as $argument) {
    if (strncmp($argument, '--execute=', strlen('--execute=')) === 0) {
        $execute = substr($argument, strlen('--execute='));
    }
}

if ($execute !== null) {
    try {
        eval($execute);
    } catch (Throwable $e) {
        // the same words the loop says, and the status a failed command has:
        // the caller reads the output rather than waiting for an envelope that
        // cannot be printed
        echo PHP_EOL, 'PHP ', get_class($e), ': ', $e->getMessage(), PHP_EOL;

        exit(1);
    }

    exit(0);
}

// icanon off is what lifts the 4096-byte line limit, and echo off leaves the
// echo to the loop below, which is where psysh's readline does it too
@shell_exec('stty -F /dev/tty -icanon -echo 2>/dev/null');

$stdin = fopen('php://stdin', 'r');

// psysh's prompts: `> ` when it reads a statement, `. ` behind one that is not
// finished. The app types a run a line at a time and waits for one of them
// between lines (see Session#type), and a run is one statement over several
// lines (see runResult.typedRun), which is read whole before it is evaluated
$pending = '';

echo '> ';

while (($line = fgets($stdin)) !== false) {
    $code = rtrim($line, "\r\n");

    // the readline's own echo of what was typed
    echo $code . "\r\n";

    if ($pending === '' && trim($code) === '') {
        echo '> ';

        continue;
    }

    $pending = $pending === '' ? $code : $pending . "\n" . $code;

    try {
        token_get_all('<?php ' . $pending, TOKEN_PARSE);
    } catch (ParseError $e) {
        // a statement that has not ended yet is read on, the way psysh does: php
        // says so as an end of file, or as a bracket that is still open
        $message = $e->getMessage();

        if (strpos($message, 'end of file') !== false || strncmp($message, 'Unclosed', 8) === 0) {
            echo '. ';

            continue;
        }
    }

    $statement = $pending;
    $pending = '';

    try {
        eval($statement);
    } catch (Throwable $e) {
        // a run that broke the wrapper itself cannot answer through it; say what
        // happened rather than leaving the app waiting for an envelope
        echo PHP_EOL, 'PHP ', get_class($e), ': ', $e->getMessage(), PHP_EOL;
    }

    echo PHP_EOL, '> ';
}
