#!/usr/bin/env php
<?php

/*
 * A tinker-compatible session for Tinkr's end-to-end tests.
 *
 * The app boots a connection's session by running the connection's command —
 * `php artisan tinker` by default — and writes a wrapped run into it. psysh is
 * what a Laravel project answers with, and it is a large dependency to install
 * for a suite whose subject is the app. This is the part of psysh the app
 * depends on: a php process that reads one line at a time and evaluates it in a
 * scope that survives the line. Nothing is stubbed in the app: the real pty, the
 * real wrapper, the real parser and the real result filter all run.
 *
 * Canonical input is turned off before the loop starts. A pty in canonical mode
 * only hands over a line of up to 4096 bytes; a run wrapper is larger than that,
 * which is why the app waits for the session to be reading before it writes. A
 * readline prompt is in raw mode and has no such limit, and neither does this.
 */

error_reporting(E_ALL);
ini_set('display_errors', '1');

$root = __DIR__;

require $root . '/vendor/illuminate/database/QueryExecuted.php';

spl_autoload_register(function ($class) use ($root) {
    $prefix = 'App\\';

    if (strncmp($class, $prefix, strlen($prefix)) !== 0) {
        return;
    }

    $file = $root . '/app/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';

    if (is_file($file)) {
        require $file;
    }
});

$config = [
    'app' => ['name' => 'Tinkr Fixture', 'env' => 'testing', 'debug' => true],
    'database' => ['default' => 'fixture'],
    'logging' => ['default' => 'stack'],
];

/**
 * Laravel's `config()` for the fixture: dot lookup, and the default when a key
 * is not there.
 */
function config($key = null, $default = null)
{
    global $config;

    if ($key === null) {
        return $config;
    }

    $value = $config;

    foreach (explode('.', $key) as $segment) {
        if (!is_array($value) || !array_key_exists($segment, $value)) {
            return $default;
        }

        $value = $value[$segment];
    }

    return $value;
}

/** One query the fixture's connection ran, shaped like Laravel's event. */
class TinkrFixtureQuery
{
    public $sql;
    public $bindings;
    public $time;
    public $connectionName;

    public function __construct($sql, $bindings, $time, $connectionName)
    {
        $this->sql = $sql;
        $this->bindings = $bindings;
        $this->time = $time;
        $this->connectionName = $connectionName;
    }
}

/** The event dispatcher the wrapper listens on for query events. */
class TinkrFixtureEvents
{
    private static $listeners = [];

    public static function listen($event, $callback)
    {
        self::$listeners[$event][] = $callback;
    }

    public static function dispatch($event, $payload)
    {
        foreach (self::$listeners[$event] ?? [] as $callback) {
            $callback($payload);
        }
    }

    // the sandbox swaps listeners around an event dispatcher; a fixture without
    // this is asked and cannot answer, which is reported rather than fatal
    public static function set($event, $payload = null)
    {
    }

    public function forget($event)
    {
    }
}

/** A pdo connection with Laravel's connection surface, enough for a guard. */
class TinkrFixtureConnection
{
    private $pdo;
    private $name;
    private $level = 0;

    public function __construct($name)
    {
        $this->name = $name;
        $this->pdo = new PDO('sqlite::memory:');
        $this->pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
        $this->pdo->exec('create table orders (id integer primary key, customer text, total real, paid integer)');
        $this->pdo->exec("insert into orders (customer, total, paid) values ('Ada', 42.5, 1), ('Grace', 18.0, 0), ('Linus', 7.25, 1)");
    }

    public function getName()
    {
        return $this->name;
    }

    public function beginTransaction()
    {
        if ($this->level === 0) {
            $this->pdo->beginTransaction();
        }

        $this->level++;
    }

    public function commit()
    {
        if ($this->level === 1) {
            $this->pdo->commit();
        }

        $this->level = max(0, $this->level - 1);
    }

    public function rollBack()
    {
        if ($this->level === 1) {
            $this->pdo->rollBack();
        }

        $this->level = max(0, $this->level - 1);
    }

    public function transactionLevel()
    {
        return $this->level;
    }

    private function run($sql, $bindings, $fetch)
    {
        $started = microtime(true);
        $statement = $this->pdo->prepare($sql);
        $statement->execute(array_values($bindings));
        $elapsed = (microtime(true) - $started) * 1000;

        TinkrFixtureEvents::dispatch(
            'Illuminate\\Database\\Events\\QueryExecuted',
            new \Illuminate\Database\Events\QueryExecuted($sql, array_values($bindings), $elapsed, $this->name)
        );

        return $fetch ? $statement->fetchAll(PDO::FETCH_ASSOC) : $statement->rowCount();
    }

    public function select($sql, $bindings = [])
    {
        return $this->run($sql, $bindings, true);
    }

    public function statement($sql, $bindings = [])
    {
        return $this->run($sql, $bindings, false);
    }

    public function insert($sql, $bindings = [])
    {
        return $this->run($sql, $bindings, false);
    }

    public function update($sql, $bindings = [])
    {
        return $this->run($sql, $bindings, false);
    }

    public function delete($sql, $bindings = [])
    {
        return $this->run($sql, $bindings, false);
    }
}

/** `DB::` as the fixture spells it. */
class DB
{
    public static function connection($name = null)
    {
        return TinkrFixture::connection($name);
    }

    public static function select($sql, $bindings = [])
